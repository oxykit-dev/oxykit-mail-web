    "apexcharts": "^5.3.5",
    "axios": "^1.11.0",
    "jwt-decode": "^4.0.0",
    "pinia": "^3.0.3",
    "quill": "2.0.2",
    "sass": "^1.92.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "vue3-apexcharts": "^1.8.0",
    "vuetify": "^3.10.1"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.1.3",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.31.0",
    "eslint-plugin-oxlint": "^1.15.0",
    "eslint-plugin-vue": "^10.4.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.15.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.2",
